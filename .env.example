# === Backend (Spring Boot) ===
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL (dev: local, prod: Heroku sobreescribe via env vars)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agrocortex
DB_USERNAME=agrocortex
DB_PASSWORD=agrocortex

# Puerto (Heroku asigna via PORT)
PORT=8080

# JWT / Security (futuro)
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# === Frontend (Angular) ===
API_URL=http://localhost:8080/api
